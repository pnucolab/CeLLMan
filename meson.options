option('simd', type: 'feature', value: 'auto',
       description: 'Enable SIMD optimizations (AVX512F)')

option('openmp', type: 'feature', value: 'auto',
       description: 'Enable OpenMP support (auto: use it when the toolchain provides it, else the single-thread fallback in utils.cpp)')

option('fast-math', type: 'boolean', value: true,
       description: 'Enable fast math optimizations')

option('native-arch', type: 'boolean', value: false,
       description: 'Enable native architecture optimizations (-march=native)')

option('debug-symbols', type: 'boolean', value: false,
       description: 'Include debug symbols in release builds')
